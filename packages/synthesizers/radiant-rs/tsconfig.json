{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "types": ["vite/client", "svelte"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
