{
  "name": "wafer-units",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present --filter './packages/**/*' build",
    "typecheck": "for f in $(find packages -name tsconfig.json | sort); do tsc -p \"$f\" || exit 1; done",
    "lint": "oxlint --type-aware --type-check"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "wafer-host": "^0.1.12"
  }
}
