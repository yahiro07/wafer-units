{
  "name": "wus-units",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present --filter './packages/**/*' build",
    "typecheck": "for f in $(find packages -name tsconfig.json | sort); do tsc -p \"$f\" || exit 1; done",
    "lint": "oxlint --type-aware"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~6.0.3",
    "vite": "^8.0.12",
    "wafer-host": "link:../wafer/wafer"
  }
}
