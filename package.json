    "@types/node": "^25.7.0",
    "@vitejs/plugin-react": "^6.0.1",
    "clsx": "^2.1.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.12",
    "vite-plugin-solid": "^2.11.12",
    "wafer-host": "link:../wafer/wafer"
